# MySQL（服务器上本地安装，默认只监听 127.0.0.1）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=donglemei
DB_USER=dlm
DB_PASSWORD=change-me

# JWT 签名密钥，生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex

# 跨域白名单。生产由 Caddy 同源托管，留空即可（留空 = 不发送任何 CORS 放行头）。
# 仅当本地前端不走 Vite 代理、直连 8080 时才需要，例如：
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

# 大模型（OpenAI 兼容端点）
LLM_API_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_API_KEY=sk-xxx
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 高德地图 Web 服务 Key，用于天气和逆地理编码；不填则回退 Open-Meteo
AMAP_KEY=

# 高德地图 Web 端（JS API）Key 和安全密钥，用于运动轨迹地图
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

# 本地开发可选：通过 SSH 隧道连接远程 MySQL
DEPLOY_HOST=
DEPLOY_SSH_KEY=
